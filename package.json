{
  "name": "bitty-buddies",
  "productName": "Bitty Buddies",
  "version": "1.1.5",
  "description": "Blocky pixel pets that live on your desktop.",
  "author": "WiggleCodes",
  "license": "SEE LICENSE IN LICENSE",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icons": "node scripts/make-icons.js",
    "preview": "node scripts/preview.js",
    "banner": "node scripts/make-banner.js",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "koffi": "^2.16.3"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.wigglecodes.bittybuddies",
    "productName": "Bitty Buddies",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_ia32/**",
      "!node_modules/koffi/src/**",
      "!node_modules/koffi/doc/**"
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "WiggleCodes",
        "repo": "bitty-buddies",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Bitty-Buddies-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/koffi/**"
    ]
  },
  "bitty": {
    "revokedUrl": "https://raw.githubusercontent.com/WiggleCodes/bitty-buddies/main/revoked.json",
    "revokedApi": "https://api.github.com/repos/WiggleCodes/bitty-buddies/contents/revoked.json",
    "statsApi": "https://abacus.jasoncameron.dev",
    "statsNamespace": "bitty-buddies",
    "reportUrl": "https://bitty-admin.reece-feetenby.workers.dev/report"
  }
}
